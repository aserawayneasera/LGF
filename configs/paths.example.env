# Copy to a private local file, replace each path, then source that file.
# These variables are used in the documented shell commands.
# The native runners do not automatically read this file.
export P1_DATA_ROOT=/absolute/path/to/DATASET
export P1_UGS_RUN_ROOT=/absolute/path/to/ugs_comparison/runs
export P1_RECENT_RUN_ROOT=/absolute/path/to/reviewer34/runs
export P1_RESULTS_ROOT=/absolute/path/to/revision_outputs
